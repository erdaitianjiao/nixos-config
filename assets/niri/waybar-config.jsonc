{
  // ── Waybar — Tokyo Night (top bar) ─────────────────
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 0,

  "modules-left":   ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right":  ["tray", "network", "bluetooth", "pulseaudio", "pulseaudio/slider", "backlight", "backlight/slider", "battery", "custom/power"],

  // ── 工作区 ─────────────────────────────────────────
  "niri/workspaces": {
    "format": "{value}",
    "all-outputs": false,
    "disable-click": false
  },

  // ── 当前窗口标题 ───────────────────────────────────
  "niri/window": {
    "format": "{title}",
    "max-length": 60,
    "icon": false,
    "separate-outputs": true
  },

  // ── 时钟（居中）────────────────────────────────────
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %A}",
    "format-alt": "{:%m-%d %H:%M:%S}"
  },

  // ── 系统托盘 ───────────────────────────────────────
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // ── 网络（你的无线网卡是 wlp2s0）─────────────────────
  "network": {
    "interface": "wlo1",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "on-click": "~/.config/waybar/wifi-menu.sh",
    "on-click-right": "nm-connection-editor",
    "tooltip-format": "{ifname}: {ipaddr} ({signalStrength}%)"
  },

  // ── 蓝牙 ───────────────────────────────────────────
  "bluetooth": {
    "format": "{icon}",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲",
      "connected": "󰂱",
      "disabled": "󰂲"
    },
    "on-click": "~/.config/waybar/bluetooth-toggle.sh",
    "on-click-right": "~/.config/waybar/bluetooth-menu.sh",
    "tooltip-format": "蓝牙"
  },

  // ── 音量 ───────────────────────────────────────────
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}"
  },

  // 音量拖拽滑块
  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  // ── 亮度 ───────────────────────────────────────────
  "backlight": {
    "device": "nvidia_wmi_ec_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃝", "󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  // 亮度拖拽滑块
  "backlight/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "device": "nvidia_wmi_ec_backlight"
  },

  // ── 电池 ───────────────────────────────────────────
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} ({power} W)"
  },

  // ── 电源菜单 ───────────────────────────────────────
  "custom/power": {
    "format": "⏻",
    "on-click": "~/.config/waybar/powermenu.sh",
    "tooltip-format": "电源菜单"
  }
}
