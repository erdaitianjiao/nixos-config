#!/usr/bin/env python3
# 点击 waybar 图标后弹出的滑块：
#   slider-popup volume      -> 音量滑块
#   slider-popup brightness  -> 内置屏滑块（有外接屏时自动再加一条外接屏）
import sys, subprocess, re, gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gio, GLib, Gdk

GLib.set_prgname("slider-popup")   # Wayland app-id（niri 浮动规则用）

mode = sys.argv[1] if len(sys.argv) > 1 else "volume"

def sh(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)

def get_volume():
    r = sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    try: return round(float(r.stdout.split()[1]) * 100)
    except Exception: return 0
def set_volume(v): sh(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(v)}%"])

def get_backlight():
    try:
        c = int(sh(["brightnessctl", "get"]).stdout or 0)
        m = int(sh(["brightnessctl", "max"]).stdout or 1)
        return round(c * 100 / m) if m else 0
    except Exception: return 0
def set_backlight(v): sh(["brightnessctl", "set", f"{int(v)}%"])

def get_ddc():
    # 读不到（没有 DDC/CI 外接屏）返回 None
    r = sh(["ddcutil", "--display", "1", "getvcp", "10"])
    m = re.search(r"current value =\s*(\d+)", r.stdout)
    return int(m.group(1)) if m else None
def set_ddc(v): sh(["ddcutil", "--display", "1", "setvcp", "10", str(int(v))])


def build_controls():
    if mode == "volume":
        return [("󰕾", "音量", get_volume, set_volume)]
    # brightness：内置屏 + （可选）外接屏
    ctrls = [("󰃟", "内置屏", get_backlight, set_backlight)]
    ext = get_ddc()
    if ext is not None:
        ctrls.append(("󰍹", "外接屏", (lambda v=ext: v), set_ddc))
    return ctrls


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.local.SliderPopup",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_default_size(320, -1)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("top", "bottom", "start", "end"):
            getattr(outer, f"set_margin_{m}")(14)

        for icon, name, getv, setv in build_controls():
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

            lbl = Gtk.Label(label=f"{icon} {name}")
            lbl.set_width_chars(8)
            lbl.set_xalign(0)

            val = int(getv() or 0)
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
            scale.set_value(val)
            scale.set_hexpand(True)
            scale.set_draw_value(False)

            vlabel = Gtk.Label(label=f"{val}%")
            vlabel.set_width_chars(4)

            def make_cb(setv=setv, vlabel=vlabel):
                def cb(s):
                    v = int(s.get_value())
                    setv(v)
                    vlabel.set_text(f"{v}%")
                return cb
            scale.connect("value-changed", make_cb())

            row.append(lbl); row.append(scale); row.append(vlabel)
            outer.append(row)

        win.set_child(outer)

        key = Gtk.EventControllerKey()
        key.connect("key-pressed",
                    lambda c, k, *a: (win.close() or True) if k == Gdk.KEY_Escape else False)
        win.add_controller(key)

        # 失焦后延迟关闭（给鼠标移动留时间）
        state = {"entered": False, "timer": 0}

        def cancel_timer():
            if state["timer"]:
                GLib.source_remove(state["timer"])
                state["timer"] = 0

        def on_enter(c):
            state["entered"] = True
            cancel_timer()

        def on_leave(c):
            if not state["entered"]:
                return
            cancel_timer()
            def close_later():
                state["timer"] = 0
                win.close()
                return False
            state["timer"] = GLib.timeout_add(1500, close_later)

        foc = Gtk.EventControllerFocus()
        foc.connect("enter", on_enter)
        foc.connect("leave", on_leave)
        win.add_controller(foc)

        win.present()


App().run()
